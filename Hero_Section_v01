<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='UTF-8'/>
<meta name='viewport' content='width=device-width, initial-scale=1.0'/>
<title>Banynova — Hero Section (Blogger-ready)</title>

<!--
  ============================================================
  BLOGGER INTEGRATION NOTES
  ============================================================
  1. The <script type='application/ld+json'> block below (WebSite / SearchAction /
     Organization) belongs in your theme's <head>, NOT inside the Hero widget.
     Move it into Blogger Layout > Edit HTML, just before </head>.
  2. Everything from <section class='hero'> down to the closing </section>
     is what you paste into an HTML/JavaScript gadget (or a Page Element)
     positioned as your homepage hero.
  3. Banynova.config (further down) is the single source of truth for
     suggestions, quick links, and stats. Update values there — the DOM
     is rendered from it on load, so nothing needs to be edited twice.
  4. URLs below are placeholders using Blogger's native patterns:
       - /search/label/Label-Name   -> label-based archive (tag pages)
       - /p/page-name.html          -> static Blogger Pages
     Swap them once your real post/page permalinks exist.
  ============================================================
-->

<script type='application/ld+json'>
//<![CDATA[
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Banynova",
      "url": "https://www.banynova.com/",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.banynova.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": "Banynova",
      "url": "https://www.banynova.com/",
      "slogan": "Fast by Design. Private by Default. Free for Everyone."
    }
  ]
}
//]]>
</script>

<style>
  :root {
    --paper: #F7F7F4;
    --surface: #FFFFFF;
    --ink: #14161A;
    --slate: #5B6472;
    --slate-soft: #8890999a;
    --line: #E3E3DE;
    --signal: #0EA5A0;
    --signal-dim: #0EA5A014;
    --signal-ring: #0EA5A044;

    --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Helvetica, Arial, sans-serif;
    --font-mono: "IBM Plex Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    --radius-lg: 18px;
    --radius-md: 12px;
    --radius-full: 999px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--paper);
    font-family: var(--font-body);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 20px 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---------- 1. Logo ---------- */
  .hero__logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 40px;
  }
  .hero__logo-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    display: inline-block;
  }

  /* ---------- 2. H1 ---------- */
  .hero__h1 {
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
    max-width: 15ch;
  }

  /* ---------- 3. Description ---------- */
  .hero__desc {
    font-size: 17px;
    line-height: 1.6;
    color: var(--slate);
    max-width: 52ch;
    margin: 0 0 36px;
  }

  /* ---------- 4. Global Search ---------- */
  .search {
    width: 100%;
    max-width: 620px;
    position: relative;
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 14px 14px 14px 18px;
    box-shadow: 0 1px 2px rgba(20,22,26,0.04), 0 8px 24px rgba(20,22,26,0.05);
    transition: border-color .15s, box-shadow .15s;
  }

  .search__field:focus-within {
    border-color: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-ring), 0 8px 24px rgba(20,22,26,0.06);
  }

  .search__icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--slate);
  }
  .search__field:focus-within .search__icon { color: var(--signal); }

  .search__input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    min-width: 0;
    padding: 6px 0;
  }
  .search__input::placeholder { color: #9AA1AC; }

  .search__clear {
    flex: none;
    display: none;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: 50%;
    background: #F0F0EE;
    color: var(--slate);
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    transition: background-color .15s;
  }
  .search__clear:hover { background-color: #E7E7E3; }
  .search__clear.is-visible { display: inline-flex; }

  .search__kbd {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--slate);
  }

  /* Visible submit button — desktop discoverability, icon-only on mobile */
  .search__submit {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .15s;
  }
  .search__submit:hover { background-color: #2A2D33; }
  .search__submit svg { width: 15px; height: 15px; }

  .search__hint {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--slate-soft);
    text-align: left;
    padding-left: 4px;
  }

  /* ---------- Autocomplete dropdown ---------- */
  .search__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 28px rgba(20,22,26,0.10);
    overflow: hidden;
    text-align: left;
    z-index: 20;
    display: none;
  }
  .search__panel.is-open { display: block; }

  .search__option {
    display: block;
    padding: 11px 16px;
    font-size: 14.5px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: background-color .12s;
  }
  .search__option:hover,
  .search__option.is-active {
    background-color: var(--signal-dim);
  }
  .search__option mark {
    background: none;
    color: var(--signal);
    font-weight: 650;
  }

  /* ---------- Hero Stats ---------- */
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }
  .stats__item {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    font-weight: 600;
  }
  .stats__item span {
    font-weight: 400;
    color: var(--slate-soft);
    margin: 0 8px 0 0;
  }

  /* ---------- 5. Suggestions ---------- */
  .suggestions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    max-width: 620px;
  }

  .suggestions__chip {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--slate);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: 7px 14px;
    text-decoration: none;
    transition: border-color .15s, color .15s, background-color .15s;
    white-space: nowrap;
  }
  .suggestions__chip:hover,
  .suggestions__chip:focus-visible {
    color: var(--signal);
    border-color: var(--signal);
    background-color: var(--signal-dim);
  }
  .suggestions__chip::before {
    content: "#";
    color: var(--slate-soft);
    margin-right: 2px;
  }
  .suggestions__chip:hover::before,
  .suggestions__chip:focus-visible::before {
    color: var(--signal);
  }

  /* ---------- 6. Quick Actions ---------- */
  .quick-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .quick-actions__btn {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 550;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 9px 16px;
    text-decoration: none;
    transition: background-color .15s, border-color .15s;
  }
  .quick-actions__btn:hover,
  .quick-actions__btn:focus-visible {
    background-color: var(--surface);
    border-color: #C9C9C3;
  }

  /* ---------- 7. Trust Indicators ---------- */
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 36px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
    max-width: 580px;
    list-style: none;
  }

  .trust__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--slate);
  }
  .trust__item svg {
    width: 15px;
    height: 15px;
    color: var(--signal);
    flex: none;
  }

  /* ---------- Accessibility ---------- */
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 640px) {
    .hero { padding: 48px 18px 40px; }
    .hero__logo { margin-bottom: 28px; }
    .hero__h1 { max-width: 100%; }
    .hero__desc { font-size: 15.5px; margin-bottom: 28px; }
    .search__field { padding: 11px 11px 11px 14px; border-radius: var(--radius-md); }
    .search__kbd { display: none; }
    .search__hint { display: none; }
    .search__submit span { display: none; }
    .search__submit { width: 36px; padding: 0; justify-content: center; }
    .stats { margin-top: 24px; gap: 8px 16px; }
    .suggestions {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
      margin-top: 20px;
    }
    .suggestions::-webkit-scrollbar { display: none; }
    .quick-actions { gap: 8px; }
    .quick-actions__btn { padding: 8px 13px; font-size: 13px; }
    .trust {
      gap: 14px 18px;
      margin-top: 28px;
      padding-top: 16px;
    }
  }
</style>
</head>
<body>

<section class='hero' aria-labelledby='hero-heading'>

  <!-- 1. Logo -->
  <a href='/' class='hero__logo' aria-label='Banynova home'>
    <span class='hero__logo-dot' aria-hidden='true'/>banynova
  </a>

  <!-- 2. H1 -->
  <h1 id='hero-heading' class='hero__h1'>Find the Right Online Tool for Any Task — Instantly</h1>

  <!-- 3. Description -->
  <p class='hero__desc'>
    Banynova is a free directory of browser-based tools for developers, writers, and everyday tasks.
    Every tool runs instantly with no installation and no signup — most process your data privately,
    right in your browser.
  </p>

  <!-- 4. Global Search -->
  <div class='search'>
    <form class='search__field' id='banynova-search-form' action='/search' method='get' role='search' autocomplete='off'>
      <svg class='search__icon' viewBox='0 0 24 24' fill='none' aria-hidden='true'>
        <circle cx='11' cy='11' r='7' stroke='currentColor' stroke-width='2'/>
        <path d='M21 21L16.65 16.65' stroke='currentColor' stroke-width='2' stroke-linecap='round'/>
      </svg>

      <label for='banynova-search-input' class='visually-hidden'>Search Banynova tools and guides</label>
      <input
        type='search'
        id='banynova-search-input'
        name='q'
        class='search__input'
        placeholder='Search tools, tutorials, or guides...'
        aria-describedby='search-kbd-hint'
        aria-autocomplete='list'
        aria-expanded='false'
        aria-controls='banynova-search-panel'
        role='combobox'
      />

      <button type='button' class='search__clear' id='banynova-search-clear' aria-label='Clear search'>&#215;</button>
      <span class='search__kbd' aria-hidden='true'>/</span>

      <button type='submit' class='search__submit' aria-label='Search'>
        <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'>
          <circle cx='11' cy='11' r='7' stroke='currentColor' stroke-width='2.2'/>
          <path d='M21 21L16.65 16.65' stroke='currentColor' stroke-width='2.2' stroke-linecap='round'/>
        </svg>
        <span>Search</span>
      </button>
    </form>

    <ul class='search__panel' id='banynova-search-panel' role='listbox' aria-label='Suggested tools'></ul>

    <p class='search__hint' id='search-kbd-hint'>Press <strong>/</strong> to jump to search from anywhere</p>
  </div>

  <!-- Hero Stats -->
  <ul class='stats' id='banynova-stats' aria-label='Banynova at a glance'></ul>

  <!-- 5. Search Suggestions (rendered from Banynova.config.popularTools) -->
  <nav aria-label='Popular searches'>
    <ul class='suggestions' id='banynova-suggestions'></ul>
  </nav>

  <!-- No-JS / crawler fallback for suggestions and quick links -->
  <noscript>
    <ul class='suggestions'>
      <li><a class='suggestions__chip' href='/search/label/Word-Counter'>Word Counter</a></li>
