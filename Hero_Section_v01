      <li><a class='suggestions__chip' href='/search/label/Base64-Encoder'>Base64 Encoder</a></li>
      <li><a class='suggestions__chip' href='/search/label/Age-Calculator'>Age Calculator</a></li>
      <li><a class='suggestions__chip' href='/search/label/UUID-Generator'>UUID Generator</a></li>
      <li><a class='suggestions__chip' href='/search/label/QR-Code-Generator'>QR Code Generator</a></li>
      <li><a class='suggestions__chip' href='/search/label/Password-Generator'>Password Generator</a></li>
    </ul>
    <ul class='quick-actions'>
      <li><a class='quick-actions__btn' href='/search/label/Popular'>Popular Tools</a></li>
      <li><a class='quick-actions__btn' href='/p/categories.html'>Browse Categories</a></li>
      <li><a class='quick-actions__btn' href='/search/label/Tutorial'>Latest Tutorials</a></li>
      <li><a class='quick-actions__btn' href='/p/resources.html'>Resources</a></li>
    </ul>
  </noscript>

  <!-- 6. Quick Actions (rendered from Banynova.config.quickLinks) -->
  <nav aria-label='Quick links'>
    <ul class='quick-actions' id='banynova-quick-actions'></ul>
  </nav>

  <!-- 7. Trust Indicators -->
  <ul class='trust' aria-label='Why Banynova'>
    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M13 2L4 14h6l-1 8 9-12h-6l1-8z' stroke='currentColor' stroke-width='2' stroke-linejoin='round'/></svg>
      Free Forever
    </li>
    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><rect x='3' y='4' width='18' height='16' rx='2' stroke='currentColor' stroke-width='2'/><path d='M3 8h18' stroke='currentColor' stroke-width='2'/></svg>
      Browser-Based
    </li>
    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z' stroke='currentColor' stroke-width='2' stroke-linejoin='round'/></svg>
      Privacy First
    </li>
    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M12 3v10m0 0l-4-4m4 4l4-4' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/><path d='M4 21h16' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><path d='M6 21L18 3' stroke='currentColor' stroke-width='2' stroke-linecap='round' opacity='0'/></svg>
      No Installation
