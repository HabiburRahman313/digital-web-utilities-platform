    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><rect x='7' y='2' width='10' height='20' rx='2' stroke='currentColor' stroke-width='2'/><path d='M11 18h2' stroke='currentColor' stroke-width='2' stroke-linecap='round'/></svg>
      Mobile Friendly
    </li>
    <li class='trust__item'>
      <svg viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M13 2L4 14h6l-1 8 9-12h-6l1-8z' stroke='currentColor' stroke-width='2' stroke-linejoin='round'/></svg>
      Fast Loading
    </li>
  </ul>

</section>

<script>
  // Single source of truth for Hero (and future homepage / search page) content.
  // Update this object only — the DOM below is rendered from it.
  window.Banynova = window.Banynova || {};
  Banynova.config = {
    popularTools: [
      { label: 'Word Counter',       url: '/search/label/Word-Counter' },
      { label: 'JSON Formatter',     url: '/search/label/JSON-Formatter' },
      { label: 'Image Compressor',   url: '/search/label/Image-Compressor' },
      { label: 'Base64 Encoder',     url: '/search/label/Base64-Encoder' },
      { label: 'Age Calculator',     url: '/search/label/Age-Calculator' },
      { label: 'UUID Generator',     url: '/search/label/UUID-Generator' },
      { label: 'QR Code Generator',  url: '/search/label/QR-Code-Generator' },
      { label: 'Password Generator', url: '/search/label/Password-Generator' }
    ],
    quickLinks: [
      { label: 'Popular Tools',     url: '/search/label/Popular' },
      { label: 'Browse Categories', url: '/p/categories.html' },
      { label: 'Latest Tutorials',  url: '/search/label/Tutorial' },
      { label: 'Resources',         url: '/p/resources.html' }
    ],
    stats: [
      { value: '100+', label: 'Tools' },
      { value: '100%', label: 'Free' },
      { value: '',     label: 'Browser-Based' },
      { value: '',     label: 'Privacy First' }
    ],
    search: {
      paramName: 'q',
      defaultPlaceholder: 'Search tools, tutorials, or guides...',
      rotatePlaceholder: true,
      rotateIntervalMs: 3200
    }
  };
</script>

<script>
//<![CDATA[
(function () {
  var cfg = Banynova.config;
  var form = document.getElementById('banynova-search-form');
  var input = document.getElementById('banynova-search-input');
  var clearBtn = document.getElementById('banynova-search-clear');
  var panel = document.getElementById('banynova-search-panel');
  var suggestionsList = document.getElementById('banynova-suggestions');
  var quickActionsList = document.getElementById('banynova-quick-actions');
  var statsList = document.getElementById('banynova-stats');

  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Render suggestions, quick links, stats from config ---------- */

  suggestionsList.innerHTML = cfg.popularTools.map(function (tool) {
    return '<li><a class="suggestions__chip" href="' + tool.url + '">' + tool.label + '</a></li>';
  }).join('');

  quickActionsList.innerHTML = cfg.quickLinks.map(function (link) {
    return '<li><a class="quick-actions__btn" href="' + link.url + '">' + link.label + '</a></li>';
  }).join('');

  statsList.innerHTML = cfg.stats.map(function (stat) {
    var value = stat.value ? '<span>' + stat.value + '</span>' : '';
    return '<li class="stats__item">' + value + stat.label + '</li>';
  }).join('');

  /* ---------- Clear button ---------- */

  function toggleClear() {
    clearBtn.classList.toggle('is-visible', input.value.length > 0);
  }
  input.addEventListener('input', toggleClear);
  clearBtn.addEventListener('click', function () {
    input.value = '';
    toggleClear();
    closePanel();
    input.focus();
  });

  /* ---------- "/" keyboard shortcut ---------- */

  document.addEventListener('keydown', function (e) {
    var tag = document.activeElement.tagName;
    var isTyping = tag === 'INPUT' || tag === 'TEXTAREA' || document.activeElement.isContentEditable;
    if (e.key === '/' && !isTyping) {
      e.preventDefault();
      input.focus();
    }
    if (e.key === 'Escape') {
      closePanel();
    }
  });

  /* ---------- Placeholder rotation ----------
     Skipped entirely when the user prefers reduced motion, and paused
     whenever the field is focused or has a value, so it never competes
     with something the user is actively doing. */

  var rotateTimer = null;
  var rotateIndex = 0;

  function startRotation() {
    if (!cfg.search.rotatePlaceholder || reducedMotion) return;
    rotateTimer = window.setInterval(function () {
      if (document.activeElement === input || input.value) return;
      rotateIndex = (rotateIndex + 1) % cfg.popularTools.length;
      input.setAttribute('placeholder', 'Search ' + cfg.popularTools[rotateIndex].label + '...');
    }, cfg.search.rotateIntervalMs);
  }

  input.addEventListener('focus', function () {
    input.setAttribute('placeholder', cfg.search.defaultPlaceholder);
  });
  input.addEventListener('blur', function () {
    if (!input.value) input.setAttribute('placeholder', cfg.search.defaultPlaceholder);
  });

  startRotation();

  /* ---------- Autocomplete ---------- */

  var activeIndex = -1;
  var currentMatches = [];

  function openPanel() {
    panel.classList.add('is-open');
    input.setAttribute('aria-expanded', 'true');
  }
  function closePanel() {
    panel.classList.remove('is-open');
    panel.innerHTML = '';
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    activeIndex = -1;
    currentMatches = [];
  }

  function highlight(label, query) {
    var i = label.toLowerCase().indexOf(query.toLowerCase());
    if (i === -1) return label;
    return label.slice(0, i) + '<mark>' + label.slice(i, i + query.length) + '</mark>' + label.slice(i + query.length);
  }

  function renderMatches(query) {
    currentMatches = cfg.popularTools.filter(function (t) {
      return t.label.toLowerCase().indexOf(query.toLowerCase()) !== -1;
    }).slice(0, 5);

    if (!currentMatches.length) { closePanel(); return; }

    panel.innerHTML = currentMatches.map(function (tool, i) {
      return '<li class="search__option" id="option-' + i + '" role="option" data-url="' + tool.url + '" data-label="' + tool.label + '">' +
        highlight(tool.label, query) + '</li>';
    }).join('');

    activeIndex = -1;
    openPanel();
  }

  input.addEventListener('input', function () {
    var q = input.value.trim();
    if (!q) { closePanel(); return; }
    renderMatches(q);
  });

  panel.addEventListener('click', function (e) {
    var opt = e.target.closest('.search__option');
    if (!opt) return;
    window.location.href = opt.getAttribute('data-url');
  });

  input.addEventListener('keydown', function (e) {
    if (!panel.classList.contains('is-open')) return;
    var options = panel.querySelectorAll('.search__option');
    if (!options.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = (activeIndex + 1) % options.length;
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = (activeIndex - 1 + options.length) % options.length;
    } else if (e.key === 'Enter' && activeIndex !== -1) {
      e.preventDefault();
      window.location.href = options[activeIndex].getAttribute('data-url');
      return;
    } else {
      return;
    }

    options.forEach(function (o) { o.classList.remove('is-active'); });
    options[activeIndex].classList.add('is-active');
    input.setAttribute('aria-activedescendant', options[activeIndex].id);
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.search')) closePanel();
  });

  /* Form still submits to /search?q=... normally — this only enhances it. */
  form.addEventListener('submit', function () {
    closePanel();
  });
})();
