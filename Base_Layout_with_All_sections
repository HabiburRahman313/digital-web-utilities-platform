    // required because on label/archive pages this includable renders once
    // per post, and a page-wide '.bn-tool-page img' selector would treat
    // the whole page's first image as the one to skip, not each post's own.
    var article = document.currentScript && document.currentScript.closest('.bn-tool-page');
    var imgs = article ? article.querySelectorAll('img') : [];
    for (var i = 1; i < imgs.length; i++) {
