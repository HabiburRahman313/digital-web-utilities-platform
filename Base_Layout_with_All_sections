      { name: 'Base64 Encoder', slug: 'search/label/Base64-Encoder', cat: 'Developer Tools', icon: 'dev', desc: 'Encode or decode Base64 strings and files.', popular: false, isNew: true },
      { name: 'Age Calculator', slug: 'search/label/Age-Calculator', cat: 'Calculators', icon: 'calc', desc: 'Find exact age in years, months, and days.', popular: false, isNew: true },
      { name: 'UUID Generator', slug: 'search/label/UUID-Generator', cat: 'Developer Tools', icon: 'dev', desc: 'Generate RFC-4122 compliant UUIDs.', popular: false, isNew: true }
    ],
