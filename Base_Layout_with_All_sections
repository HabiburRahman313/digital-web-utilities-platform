      { name: 'JSON Formatter', slug: 'search/label/JSON-Formatter', cat: 'Developer Tools', icon: 'dev', desc: 'Beautify, validate, and minify JSON instantly.', popular: true, isNew: false },
      { name: 'Image Compressor', slug: 'search/label/Image-Compressor', cat: 'Image Tools', icon: 'image', desc: 'Shrink image file size without losing quality.', popular: true, isNew: false },
