      Banynova.utils.qsa('#bn-nav-primary a, #bn-mobile-nav a').forEach(function (link) {
        var target = Banynova.navigation.normalizeUrl(link.href);
        if (target === here) { link.setAttribute('aria-current', 'page'); }
      });
    },
    init: function () {
      this.initScrollEffect();
      this.initMobileMenu();
      this.initActiveLink();
      var yearEl = document.getElementById('bn-year');
      if (yearEl) { yearEl.textContent = String(new Date().getFullYear()); }
    }
  });

  /* ------------------------------------------------------------------------
     HOMEPAGE HERO SEARCH — the module name/shape follows the exact usage
     documented above in Banynova.register()'s own comment. Config lives in
     one place (this object) and both the suggestion chips and quick-link
     buttons are rendered from it, so nothing has to be edited twice.
     init() bails out immediately when the hero form isn't in the DOM,
     which is true on every page except the homepage (see the b:if in the
     Main section) — so this module is always safe to call from init().
     ------------------------------------------------------------------------ */
  Banynova.register('search', {
    config: {
      popularTools: [
        { label: 'Word Counter',       path: 'search/label/Word-Counter' },
        { label: 'JSON Formatter',     path: 'search/label/JSON-Formatter' },
        { label: 'Image Compressor',   path: 'search/label/Image-Compressor' },
        { label: 'Base64 Encoder',     path: 'search/label/Base64-Encoder' },
        { label: 'Age Calculator',     path: 'search/label/Age-Calculator' },
        { label: 'UUID Generator',     path: 'search/label/UUID-Generator' },
        { label: 'QR Code Generator',  path: 'search/label/QR-Code-Generator' },
        { label: 'Password Generator', path: 'search/label/Password-Generator' }
      ],
      quickLinks: [
        { label: 'Popular Tools',     path: '#popular-tools' },
        { label: 'Browse Categories', path: '#categories' },
        { label: 'Latest Articles',   path: '#latest-articles' },
        { label: 'New Tools',         path: '#new-tools' }
      ],
      stats: [
        { value: '100+', label: 'Tools' },
        { value: '100%', label: 'Free' },
        { value: '', label: 'Browser-Based' },
        { value: '', label: 'Privacy First' }
      ],
      defaultPlaceholder: 'Search tools, tutorials, or guides...',
      rotateIntervalMs: 3200
    },
    init: function () {
      var form = document.getElementById('bn-hero-search-form');
      if (!form) { return; }

      var cfg = this.config;
      var section = document.getElementById('bn-hero');
      var home = section.getAttribute('data-home') || '/';
      var input = document.getElementById('bn-hero-search-input');
      var clearBtn = document.getElementById('bn-hero-search-clear');
      var panel = document.getElementById('bn-hero-search-panel');
      var suggestionsList = document.getElementById('bn-hero-suggestions');
      var actionsList = document.getElementById('bn-hero-actions');
      var statsList = document.getElementById('bn-hero-stats');
      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var activeIndex = -1;

      function url(path) { return home + path; }

      suggestionsList.innerHTML = cfg.popularTools.map(function (t) {
        return '<li><a class="bn-hero-chip" href="' + url(t.path) + '">' + t.label + '</a></li>';
      }).join('');

      actionsList.innerHTML = cfg.quickLinks.map(function (l) {
        return '<li><a class="bn-hero-action-btn" href="' + url(l.path) + '">' + l.label + '</a></li>';
      }).join('');

      statsList.innerHTML = cfg.stats.map(function (s) {
        var value = s.value ? '<span>' + s.value + '</span>' : '';
        return '<li>' + value + s.label + '</li>';
      }).join('');

      function toggleClear() { clearBtn.classList.toggle('is-visible', input.value.length > 0); }
      input.addEventListener('input', toggleClear);
      clearBtn.addEventListener('click', function () {
        input.value = '';
        toggleClear();
        closePanel();
        input.focus();
      });

      document.addEventListener('keydown', function (e) {
        var tag = document.activeElement.tagName;
        var isTyping = tag === 'INPUT' || tag === 'TEXTAREA' || document.activeElement.isContentEditable;
        if (e.key === '/' && !isTyping) { e.preventDefault(); input.focus(); }
        if (e.key === 'Escape') { closePanel(); }
      });

      if (!reducedMotion) {
        var rotateIndex = 0;
        window.setInterval(function () {
          if (document.activeElement === input || input.value) { return; }
          rotateIndex = (rotateIndex + 1) % cfg.popularTools.length;
          input.setAttribute('placeholder', 'Search ' + cfg.popularTools[rotateIndex].label + '...');
        }, cfg.rotateIntervalMs);
      }
      input.addEventListener('blur', function () {
        if (!input.value) { input.setAttribute('placeholder', cfg.defaultPlaceholder); }
      });

      function openPanel() { panel.classList.add('is-open'); input.setAttribute('aria-expanded', 'true'); }
      function closePanel() {
        panel.classList.remove('is-open');
        panel.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        activeIndex = -1;
      }
      function highlight(label, query) {
        var i = label.toLowerCase().indexOf(query.toLowerCase());
        if (i === -1) { return label; }
        return label.slice(0, i) + '<mark>' + label.slice(i, i + query.length) + '</mark>' + label.slice(i + query.length);
      }

      input.addEventListener('input', function () {
        var q = input.value.trim();
        if (!q) { closePanel(); return; }
        var matches = cfg.popularTools.filter(function (t) {
          return t.label.toLowerCase().indexOf(q.toLowerCase()) !== -1;
        }).slice(0, 5);
        if (!matches.length) { closePanel(); return; }
        panel.innerHTML = matches.map(function (t, i) {
          return '<li class="bn-hero-search-option" id="bn-hero-option-' + i + '" role="option" data-url="' + url(t.path) + '">' + highlight(t.label, q) + '</li>';
        }).join('');
        activeIndex = -1;
        openPanel();
      });

      panel.addEventListener('click', function (e) {
        var opt = e.target.closest('.bn-hero-search-option');
        if (opt) { window.location.href = opt.getAttribute('data-url'); }
      });

      input.addEventListener('keydown', function (e) {
        if (!panel.classList.contains('is-open')) { return; }
        var options = panel.querySelectorAll('.bn-hero-search-option');
        if (!options.length) { return; }
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = (activeIndex + 1) % options.length; }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = (activeIndex - 1 + options.length) % options.length; }
        else if (e.key === 'Enter' && activeIndex !== -1) { e.preventDefault(); window.location.href = options[activeIndex].getAttribute('data-url'); return; }
        else { return; }
        options.forEach(function (o) { o.classList.remove('is-active'); });
        options[activeIndex].classList.add('is-active');
        input.setAttribute('aria-activedescendant', options[activeIndex].id);
      });

      document.addEventListener('click', function (e) {
        if (!e.target.closest('.bn-hero-search')) { closePanel(); }
      });
      form.addEventListener('submit', function () { closePanel(); });
    }
  });

